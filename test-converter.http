Content-Type: application/xml
Accept: application/json

<Company>
    <Name>Google</Name>
    <Location country="USA">Mountain View</Location>
    <Departments>
        <Dept>
            <Dname>Engineering</Dname>
            <Employees>
                <Emp id="101">
                    <Name>Kim</Name>
                    <Role>Developer</Role>
                </Emp>
                <Emp id="102">
                    <Name>Lee</Name>
                    <Role>Designer</Role>
                </Emp>
            </Employees>
        </Dept>
        <Dept>
            <Dname>Marketing</Dname>
            <Employees>
